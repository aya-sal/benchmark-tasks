#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def DomeLight "Light"
    {
        float inputs:intensity = 850
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3 xformOp:scale = (1.1, 1.3, 0.06)
        double3 xformOp:translate = (0.36, 0, 0.7175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "box" (
        prepend references = @./assets/prepped/toolbox_pack_open.usda@
    )
    {
        bool physics:kinematicEnabled = 1
        float xformOp:rotateZ = 180
        float3 xformOp:scale = (1.491, 1.2075, 0.4515)
        double3 xformOp:translate = (0.38, 0, 0.7485)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }

    def Xform "lubricant" (
        prepend apiSchemas = ["PhysicsMassAPI"]
        prepend references = @./assets/prepped/lubricant.usda@
    )
    {
        float physics:mass = 0.3
        float xformOp:rotateZ = 0
        float3 xformOp:scale = (0.651, 0.651, 0.651)
        double3 xformOp:translate = (0.334, 0.105, 0.756305575)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }

    def Xform "spray" (
        prepend apiSchemas = ["PhysicsMassAPI"]
        prepend references = @./assets/prepped/spray.usda@
    )
    {
        float physics:mass = 0.28
        float xformOp:rotateZ = 0
        float3 xformOp:scale = (0.819, 0.819, 0.819)
        double3 xformOp:translate = (0.344, 0.229, 0.756565975)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }
}

